# Cesson au quotidien : planification des collecteurs sur le VPS (crontab -e de l'utilisateur cesson).
# Les cadences suivent le document d'architecture. Chaque ligne publie dans /srv/cesson/public,
# servi par nginx derrière le CDN (Cache-Control court, voir nginx.conf).
CESSON=/srv/cesson/backend
CESSON_ALERTE_URL=https://ntfy.sh/remplacer-par-un-sujet-prive
PATH=/usr/bin:/bin

# Quotidien, 6h05 : hauteur de la Vilaine (carte informative ; les alertes viendront de Vigicrues)
5 6 * * *     cd $CESSON && .venv/bin/python -m cesson collecter vilaine --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Quotidien, 0h05 : horaires des équipements (14 jours) et prochaines collectes de déchets (8 semaines), depuis saisie/
5 0 * * *     cd $CESSON && .venv/bin/python -m cesson collecter equipements collecte --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Quotidien, 2h40 : lignes STAR qui desservent Cesson. Après la publication du GTFS STAR (vers 23h30) et
# surtout après la remise à zéro du quota commun de data.explore.star.fr (0h00 UTC, soit 1h ou 2h à Paris) :
# à 0h40, le quota de la veille était déjà épuisé (HTTP 429 le 16/11).
40 2 * * *    cd $CESSON && .venv/bin/python -m cesson collecter lignes_star --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Quotidien, 16h20 (Air Breizh publie l'indice ATMO vers 15h45, les pollens vers 16h15) et rattrapage à 18h20 :
# qualité de l'air de Rennes Métropole et pollens de Cesson (Atmo Data, identifiants dans /srv/cesson/secrets/atmo.env)
20 16,18 * * * cd $CESSON && .venv/bin/python -m cesson collecter qualite_air pollens --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# 7h20, 11h20, 16h20 et 18h20 : épisodes de pollution en Ille-et-Vilaine (procédures préfectorales, mises à jour en journée)
20 7,11,16,18 * * * cd $CESSON && .venv/bin/python -m cesson collecter episodes_pollution --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Horaire, à la 27e minute : actualités de la ville (RSS), restrictions d'eau (VigiEau) et consignes d'Eau du Bassin Rennais
27 * * * *    cd $CESSON && .venv/bin/python -m cesson collecter actus usages_eau --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Horaire, à la 7e minute : météo (Open-Meteo, modèles Météo-France)
7 * * * *     cd $CESSON && .venv/bin/python -m cesson collecter meteo --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 15 min (3, 18, 33, 48) : vigilance crues du tronçon Vilaine amont
3-59/15 * * * * cd $CESSON && .venv/bin/python -m cesson collecter vigicrues --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Trains à la halte (GTFS extrait une fois par jour, GTFS-RT à chaque passage), de 5h à 23h59 :
# toutes les 2 min aux heures de pointe en semaine (6h-10h, 17h-21h), toutes les 5 min le reste du temps.
*/2 6-9,17-20 * * 1-5   cd $CESSON && .venv/bin/python -m cesson collecter trains --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
*/5 5,10-16,21-23 * * 1-5 cd $CESSON && .venv/bin/python -m cesson collecter trains --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
*/5 5-23 * * 0,6        cd $CESSON && .venv/bin/python -m cesson collecter trains --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Circulation sur la rocade est et les axes de Cesson (Rennes Métropole, temps réel) : toutes les 3 min aux
# heures de pointe en semaine, toutes les 10 min le reste de la journée et le week-end, toutes les 30 min la nuit.
*/3 6-9,17-20 * * 1-5   cd $CESSON && .venv/bin/python -m cesson collecter circulation --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
*/10 10-16 * * 1-5      cd $CESSON && .venv/bin/python -m cesson collecter circulation --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
*/10 6-20 * * 0,6       cd $CESSON && .venv/bin/python -m cesson collecter circulation --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
*/30 0-5,21-23 * * *    cd $CESSON && .venv/bin/python -m cesson collecter circulation --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 30 min (1, 31) : prix des carburants des stations de Cesson (ils changent quelques fois par jour)
1,31 * * * *            cd $CESSON && .venv/bin/python -m cesson collecter carburants --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 6 h (0h45, 6h45, 12h45, 18h45) : agenda de la ville (extraction de son site, à pas lents)
45 */6 * * *  cd $CESSON && .venv/bin/python -m cesson collecter agenda --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Deux fois par jour (7h20, 19h20) : séances du cinéma Le Sévigné (grille mensuelle en PDF)
20 7,19 * * * cd $CESSON && .venv/bin/python -m cesson collecter cinema --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Hebdomadaire, lundi 3h15 : défibrillateurs (Géo'DAE) et bornes de recharge (IRVE)
15 3 * * 1    cd $CESSON && .venv/bin/python -m cesson collecter defibrillateurs bornes --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
40 6,12,18 * * * cd $CESSON && .venv/bin/python -m cesson collecter familles --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1
50 5 * * *    cd $CESSON && .venv/bin/python -m cesson collecter vacances_scolaires --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Contrôle de santé toutes les heures : sort en erreur (et cron envoie un mail) si une source est en retard.
17 * * * *    cd $CESSON && .venv/bin/python -m cesson sante --etat /srv/cesson/etat > /dev/null
