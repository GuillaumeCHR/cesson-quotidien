# Cesson au quotidien : planification des collecteurs sur le VPS (crontab -e de l'utilisateur cesson).
# Les cadences suivent le document d'architecture. Chaque ligne publie dans /srv/cesson/public,
# servi par nginx derrière le CDN (Cache-Control court, voir nginx.conf).
CESSON=/srv/cesson/backend
CESSON_ALERTE_URL=https://ntfy.sh/remplacer-par-un-sujet-prive
PATH=/usr/bin:/bin

# Quotidien, 6h05 : hauteur de la Vilaine (carte informative ; les alertes viendront de Vigicrues)
5 6 * * *     cd $CESSON && .venv/bin/python -m cesson collecter vilaine --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Quotidien, 0h05 : horaires des équipements (14 jours) et prochaines collectes de déchets (8 semaines), depuis saisie/
5 0 * * *     cd $CESSON && .venv/bin/python -m cesson collecter equipements collecte --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Quotidien, 0h40 (après la publication du GTFS STAR vers 23h30) : lignes STAR qui desservent Cesson
40 0 * * *    cd $CESSON && .venv/bin/python -m cesson collecter lignes_star --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Horaire, à la 27e minute : actualités de la ville (RSS), restrictions d'eau (VigiEau) et consignes d'Eau du Bassin Rennais
27 * * * *    cd $CESSON && .venv/bin/python -m cesson collecter actus usages_eau --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Horaire, à la 7e minute : météo (Open-Meteo, modèles Météo-France)
7 * * * *     cd $CESSON && .venv/bin/python -m cesson collecter meteo --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 15 min (3, 18, 33, 48) : vigilance crues du tronçon Vilaine amont
3-59/15 * * * * cd $CESSON && .venv/bin/python -m cesson collecter vigicrues --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 2 min de 5h à 23h59 : trains à la halte (GTFS extrait une fois par jour, GTFS-RT à chaque passage)
*/2 5-23 * * *  cd $CESSON && .venv/bin/python -m cesson collecter trains --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 3 min : circulation sur la rocade est et les axes de Cesson (Rennes Métropole, temps réel)
*/3 * * * *   cd $CESSON && .venv/bin/python -m cesson collecter circulation --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Toutes les 10 min (1, 11, 21…) : prix des carburants des stations de Cesson
1-59/10 * * * * cd $CESSON && .venv/bin/python -m cesson collecter carburants --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Hebdomadaire, lundi 3h15 : défibrillateurs (Géo'DAE) et bornes de recharge (IRVE)
15 3 * * 1    cd $CESSON && .venv/bin/python -m cesson collecter defibrillateurs bornes --sortie /srv/cesson/public --etat /srv/cesson/etat >> /srv/cesson/log/collecte.log 2>&1

# Contrôle de santé toutes les heures : sort en erreur (et cron envoie un mail) si une source est en retard.
17 * * * *    cd $CESSON && .venv/bin/python -m cesson sante --etat /srv/cesson/etat > /dev/null
